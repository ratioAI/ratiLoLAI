// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ffmpegRecordArgs > finds the window by its executable without the helper, and records no sound 1`] = `
[
  "-hide_banner",
  "-loglevel",
  "warning",
  "-stats",
  "-stats_period",
  "2",
  "-y",
  "-filter_complex",
  "gfxcapture=window_exe='^League of Legends\\\\.exe$':capture_cursor=1:max_framerate=30:width=-2:height=-2,fps=30[v]",
  "-map",
  "[v]",
  "-c:v",
  "hevc_amf",
  "-usage",
  "transcoding",
  "-quality",
  "balanced",
  "-rc",
  "qvbr",
  "-qvbr_quality_level",
  "22",
  "-g",
  "30",
  "-f",
  "segment",
  "-segment_time",
  "2",
  "-segment_format",
  "mp4",
  "-segment_format_options",
  "movflags=+frag_keyframe+empty_moov+default_base_moof",
  "-segment_list",
  "/tmp/rec/segments.csv",
  "-segment_list_type",
  "csv",
  "-segment_list_flags",
  "+live",
  "-reset_timestamps",
  "0",
  "/tmp/rec/seg_%06d.mp4",
]
`;

exports[`ffmpegRecordArgs > maps GPU frames for Quick Sync and crops the desktop duplication to the window 1`] = `
[
  "-hide_banner",
  "-loglevel",
  "warning",
  "-stats",
  "-stats_period",
  "2",
  "-y",
  "-init_hw_device",
  "d3d11va=dx",
  "-init_hw_device",
  "qsv=qs@dx",
  "-filter_hw_device",
  "dx",
  "-f",
  "s16le",
  "-ar",
  "48000",
  "-ac",
  "2",
  "-thread_queue_size",
  "1024",
  "-i",
  "pipe",
  "-filter_complex",
  "ddagrab=output_idx=1:framerate=60:draw_mouse=1:video_size=1282x722:offset_x=320:offset_y=180,hwmap=derive_device=qsv,format=qsv[v]",
  "-map",
  "[v]",
  "-map",
  "0:a",
  "-c:v",
  "h264_qsv",
  "-preset",
  "medium",
  "-global_quality",
  "23",
  "-g",
  "60",
  "-c:a",
  "aac",
  "-b:a",
  "160k",
  "-ac",
  "2",
  "-f",
  "segment",
  "-segment_time",
  "2",
  "-segment_format",
  "mp4",
  "-segment_format_options",
  "movflags=+frag_keyframe+empty_moov+default_base_moof",
  "-segment_list",
  "D:/rec/segments.csv",
  "-segment_list_type",
  "csv",
  "-segment_list_flags",
  "+live",
  "-reset_timestamps",
  "0",
  "D:/rec/seg_%06d.mp4",
]
`;

exports[`ffmpegRecordArgs > records a test picture for a limited time (admin tool) 1`] = `
[
  "-hide_banner",
  "-loglevel",
  "warning",
  "-stats",
  "-stats_period",
  "2",
  "-y",
  "-f",
  "lavfi",
  "-i",
  "sine=frequency=440:sample_rate=48000",
  "-filter_complex",
  "testsrc2=size=1920x1080:rate=60,format=nv12[v]",
  "-map",
  "[v]",
  "-map",
  "0:a",
  "-c:v",
  "av1_nvenc",
  "-preset",
  "p4",
  "-tune",
  "hq",
  "-rc",
  "vbr",
  "-cq",
  "34",
  "-b:v",
  "0",
  "-g",
  "60",
  "-c:a",
  "aac",
  "-b:a",
  "160k",
  "-ac",
  "2",
  "-t",
  "20",
  "-f",
  "segment",
  "-segment_time",
  "2",
  "-segment_format",
  "mp4",
  "-segment_format_options",
  "movflags=+frag_keyframe+empty_moov+default_base_moof",
  "-segment_list",
  "/tmp/t/segments.csv",
  "-segment_list_type",
  "csv",
  "-segment_list_flags",
  "+live",
  "-reset_timestamps",
  "0",
  "/tmp/t/seg_%06d.mp4",
]
`;

exports[`ffmpegRecordArgs > records the game window by its handle with the sound from the pipe 1`] = `
[
  "-hide_banner",
  "-loglevel",
  "warning",
  "-stats",
  "-stats_period",
  "2",
  "-y",
  "-f",
  "s16le",
  "-ar",
  "48000",
  "-ac",
  "2",
  "-thread_queue_size",
  "1024",
  "-i",
  "\\\\.\\pipe\\ratio-audio-1",
  "-filter_complex",
  "gfxcapture=hwnd=132456:capture_cursor=1:max_framerate=60:width=1920:height=1080:resize_mode=scale_aspect:scale_mode=bilinear,fps=60[v]",
  "-map",
  "[v]",
  "-map",
  "0:a",
  "-c:v",
  "av1_nvenc",
  "-preset",
  "p4",
  "-tune",
  "hq",
  "-rc",
  "vbr",
  "-cq",
  "34",
  "-b:v",
  "0",
  "-g",
  "60",
  "-c:a",
  "aac",
  "-b:a",
  "160k",
  "-ac",
  "2",
  "-f",
  "segment",
  "-segment_time",
  "2",
  "-segment_format",
  "mp4",
  "-segment_format_options",
  "movflags=+frag_keyframe+empty_moov+default_base_moof",
  "-segment_list",
  "C:/Videos/ratioAI/rec/42/segments.csv",
  "-segment_list_type",
  "csv",
  "-segment_list_flags",
  "+live",
  "-reset_timestamps",
  "0",
  "C:/Videos/ratioAI/rec/42/seg_%06d.mp4",
]
`;

exports[`segments > builds the concat list and the stream-copy arguments 1`] = `
[
  "-hide_banner",
  "-loglevel",
  "error",
  "-y",
  "-f",
  "concat",
  "-safe",
  "0",
  "-i",
  "list.txt",
  "-ss",
  "1",
  "-t",
  "6",
  "-c",
  "copy",
  "-avoid_negative_ts",
  "make_zero",
  "-movflags",
  "+faststart",
  "out.mp4",
]
`;
